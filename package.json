{
  "name": "xtracticle",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && node scripts/check-dist.mjs",
    "build:ext": "node extension/build.mjs && node scripts/check-ext.mjs",
    "build:ext:dev": "node extension/build.mjs --dev && node scripts/check-ext.mjs extension/dist-dev",
    "build:all": "npm run build && npm run build:ext",
    "preview": "vite preview",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p extension/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node extension/test/e2e/cookie-test.mjs",
    "preview:worker": "npm run build && wrangler dev",
    "curate": "node scripts/curate.mjs"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "fflate": "^0.8.3",
    "html2canvas-pro": "^2.4.5",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250410.0",
    "@types/chrome": "^0.3.7",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vitest": "^3.2.7",
    "wrangler": "^4.14.4"
  }
}
