{
  "name": "xtracticle",
  "compatibility_date": "2025-09-01",
  "main": "src/worker.ts",
  "keep_vars": true,
  "vars": {
    "POLAR_ORG_ID": "",
    "POLAR_CHECKOUT_MONTHLY": "https://buy.polar.sh/polar_cl_W3sgHJNjsMIb7BHk5NDYDQgTAM8UckE6K7i0O2BjoVi",
    "POLAR_CHECKOUT_YEARLY": "https://buy.polar.sh/polar_cl_6tEESB0j8mDEDxSesC7MTs2GAxuDy2kN2VCo140Y9Cc",
    "POLAR_CHECKOUT_LIFETIME": "https://buy.polar.sh/polar_cl_gew62o5BENC5YphASoEofWzQhGfS2uA1RQU930khO9X",
    "POLAR_BENEFIT_MONTHLY": "",
    "POLAR_BENEFIT_YEARLY": "",
    "POLAR_BENEFIT_LIFETIME": ""
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/mcp",
      "/mcp/",
      "/*/status/*",
      "/i/web/status/*",
      "/video/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "API_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 40,
        "period": 10
      }
    },
    {
      "name": "AGENT_IP_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "AGENT_GLOBAL_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 40,
        "period": 60
      }
    }
  ]
}
