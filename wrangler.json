{
  "name": "xtracticle",
  "compatibility_date": "2025-09-01",
  "main": "src/worker.ts",
  "keep_vars": true,
  "migrations_dir": "migrations",
  "d1_databases": [
    {
      "binding": "WATCH_DB",
      "database_name": "xtracticle-watch",
      "database_id": "868dda1b-730a-4d60-b521-339fd55a652b"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "vars": {
    "WATCH_EMAIL_FROM": "Xtracticle <watch@xtracticle.com>",
    "WATCH_BATCH": "20",
    "WATCH_TRIAL_MAX": "300",
    "GUMROAD_PRODUCT_MEMBERSHIP": "zRyxi6_UZTOjng_IESQhkA==",
    "GUMROAD_PRODUCT_LIFETIME": "hGyDc5sjkcwOajGlD00fsQ==",
    "GUMROAD_URL_MONTHLY": "https://gumroad.com/checkout?product=jjhcgr&option=097Q4L16dycOtUBN5f2LrQ%3D%3D&recurrence=monthly&quantity=1",
    "GUMROAD_URL_YEARLY": "https://gumroad.com/checkout?product=jjhcgr&option=097Q4L16dycOtUBN5f2LrQ%3D%3D&recurrence=yearly&quantity=1",
    "GUMROAD_URL_LIFETIME": "https://gumroad.com/checkout?product=inexys&quantity=1"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/mcp",
      "/mcp/",
      "/*/status/*",
      "/i/web/status/*",
      "/video/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "API_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 40,
        "period": 10
      }
    },
    {
      "name": "AGENT_IP_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "AGENT_GLOBAL_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 40,
        "period": 60
      }
    },
    {
      "name": "TRIAL_LIMITER",
      "namespace_id": "1004",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ]
}
